# Copy to .env and fill in. Most values have safe defaults.
PORT=3001
HOST=127.0.0.1

# Persistent state directory. Keep this OUTSIDE the app checkout so deploys cannot erase it.
# Relative paths are resolved from the app root. Production defaults to ../tgdrive-data.
DATA_DIR=/home/dotplushq/domains/drive.dotplushq.online/tgdrive-data

# Random 64+ hex chars used to sign session cookies & tokens. Generate with: openssl rand -hex 32
SECRET=

# Public base URL (no trailing slash). Used for share links.
PUBLIC_URL=https://drive.dotplushq.online

# Max upload size in bytes (Telegram caps a single file at ~2GB, ~4GB with Premium).
MAX_UPLOAD_BYTES=2147483648

# Optional comma-separated list of api_id:api_hash presets offered on the login screen.
# Leave blank to require the user to enter their own each time.
API_PRESETS=

# MongoDB Atlas connection string. When set, ALL state (admin users, login sessions,
# Telegram sessions, folders, share links, API keys, upload history) is stored in
# MongoDB and survives restarts/redeploys. Leave blank to use the local SQLite file.
MONGODB_URI=
# Database name inside the cluster (default: tgdrive)
MONGODB_DB=tgdrive

# ---- Telethon upload microservice (pyservice/) ----
# When running, Telegram uploads go through it (much faster than GramJS) and
# automatically fall back to GramJS whenever it is unavailable.
UPLOAD_SERVICE_ENABLED=1
UPLOAD_SERVICE_URL=http://127.0.0.1:8765
# Shared secret sent as X-Upload-Token. Generate with: openssl rand -hex 24
UPLOAD_SERVICE_TOKEN=
